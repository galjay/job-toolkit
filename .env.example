# Text AI: OpenAI Chat Completions-compatible API.
# DeepSeek users only need to replace the key below.
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_MAX_OUTPUT_TOKENS=8192
AI_OUTPUT_TOKEN_PARAM=max_tokens

# Optional image-edit API. Leave empty to use the prompt-resource mode.
IMAGE_API_KEY=
